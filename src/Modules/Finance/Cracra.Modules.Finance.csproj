    <ProjectReference Include="../../BuildingBlocks/Web/Cracra.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="../../BuildingBlocks/Persistence/Cracra.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="../../BuildingBlocks/Abstractions/Cracra.BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="../../BuildingBlocks/Documents/Cracra.BuildingBlocks.Documents.csproj" />
    <ProjectReference Include="../../BuildingBlocks/Storage/Cracra.BuildingBlocks.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cracra.Tests.Unit" />
    <InternalsVisibleTo Include="Cracra.Tests.Integration" />
  </ItemGroup>
</Project>
