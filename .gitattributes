# Normalise line endings so a Windows checkout and a Linux CI runner produce identical blobs. Without this the
# first commit from either platform rewrites every file for the other.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff, never convert.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary

# The vendored Mobiscroll bundles are minified third-party builds. Marking them as such keeps them out of diffs
# and out of language statistics; they are committed because the package ships as a licensed zip, not from a
# registry (see docs/dev-box.md).
web/src/lib/mobiscroll/** linguist-vendored
web/src/lib/mobiscroll/**/*.min.js -diff
web/src/lib/mobiscroll/**/*.min.css -diff

# Generated by EF Core; reviewing them as prose is rarely useful.
**/Migrations/**/*.Designer.cs linguist-generated
**/Migrations/**/*ModelSnapshot.cs linguist-generated
