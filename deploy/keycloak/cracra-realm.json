{
  "realm": "cracra",
  "displayName": "Cracra — Activité & Portefeuille",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en",
    "es"
