# Copy to deploy/.env and fill in. Never commit the filled-in file.
#
# The Aspire dev box reads the same values from .NET user secrets instead (see docs/dev-box.md); this file exists
# for the compose deployment only.

POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
APP_RW_PASSWORD=

KEYCLOAK_ADMIN_PASSWORD=
# Public URL browsers use to reach Keycloak. Must be reachable from the user's browser, not just from the network
# the containers share — the OIDC redirect happens in the browser.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
BFF_CLIENT_SECRET=
# Service account the Directory module reads Keycloak with (read-only: view-users, query-groups).
SYNC_CLIENT_SECRET=

STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: OTLP collector for traces. Leave empty to disable trace export (logs still reach SEQ).
OTEL_ENDPOINT=
