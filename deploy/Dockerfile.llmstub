# Development and test only. A real deployment points Cracra__Ai__BaseUrl at the on-prem model and removes the
# llm service from the compose file entirely.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/ src/
RUN dotnet publish src/Tools/LlmStub/Cracra.Tools.LlmStub.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Cracra.Tools.LlmStub.dll"]
